{
  "name": "water12",
  "version": "1.0.0",
  "private": true,
  "description": "Michaforge Enterprises — Full-Stack Plumbing Materials E-Commerce Catalogue & Management System",
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "dev": "node scripts/start-all.js",
    "dev:web": "npm run dev -w apps/web",
    "dev:auth": "npm run dev -w services/auth-service",
    "dev:catalogue": "npm run dev -w services/catalogue-service",
    "dev:content": "npm run dev -w services/content-service",
    "dev:enquiry": "npm run dev -w services/enquiry-service",
    "dev:media": "npm run dev -w services/media-service",
    "dev:notification": "npm run dev -w services/notification-service",
    "dev:pricing": "npm run dev -w services/pricing-service",
    "dev:reporting": "npm run dev -w services/reporting-service",
    "dev:worker": "npm run dev -w services/worker-service",
    "dev:gateway": "npm run dev -w services/api-gateway",
    "build:web": "npm run build -w apps/web",
    "start:web": "npm run start -w apps/web",
    "build:packages": "npm run build -w packages/shared-contracts && npm run build -w packages/shared-validation",
    "build": "npm run build -w packages/shared-contracts && npm run build -w packages/shared-validation && npm run build --workspaces --if-present",
    "test": "echo \"No test runner configured\" && exit 0",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "caniuse-lite": "^1.0.30001820",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "next": "^14.2.15",
    "uuid": "^14.0.3"
  }
}
